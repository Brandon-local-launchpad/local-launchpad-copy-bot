# Copy to .env and fill in. Never commit .env. See ONBOARDING.md.
ANTHROPIC_API_KEY=your_key_here
PORT=3000

# Postgres. Without it the app runs, but clients, v20 pages and the WordPress push are off.
DATABASE_URL=

# Encrypts each site's WordPress Application Password: 64 hex characters
# (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
COPYBOT_SECRET_KEY=

# The app's login. Leave APP_PASSWORD empty for open access locally.
APP_PASSWORD=
APP_SECRET=

# Geo research
PERPLEXITY_API_KEY=
