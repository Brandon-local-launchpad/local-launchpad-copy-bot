ANTHROPIC_API_KEY=your_key_here
PORT=3000
# Perplexity (area research and FAQ question research use the same key)
PERPLEXITY_API_KEY=your_key_here
# Fillout onboarding webhook (POST /api/webhooks/fillout?token=...); see ONBOARDING.md
FILLOUT_WEBHOOK_SECRET=a_long_random_string

# Speech to text for a Fillout voice answer that arrived without a transcript (fillout/transcribe.js). Without it the recording is kept and marked no_transcriber.
OPENAI_API_KEY=
